#!/usr/bin/env bash
# Block direct merges between main and dev in either direction.
# These branches diverge intentionally — sync via cherry-pick only.
# See DEVELOPMENT.md for the branch strategy.

CURRENT=$(git branch --show-current)
MERGE_HEAD_REF=$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null || true)
MERGING=""
if [ -n "$MERGE_HEAD_REF" ]; then
  MERGING=$(git name-rev --name-only "$MERGE_HEAD_REF" 2>/dev/null | sed 's|remotes/origin/||')
fi

if { [[ "$CURRENT" == "main" && "$MERGING" == *"dev"* ]] ||
     [[ "$CURRENT" == "dev"  && "$MERGING" == *"main"* ]]; }; then
  echo ""
  echo "  ERROR: Direct merges between 'main' and 'dev' are not allowed."
  echo ""
  echo "  main = portable framework (stubs)"
  echo "  dev  = canon-ai dogfooding branch"
  echo ""
  echo "  Sync only via cherry-pick. See DEVELOPMENT.md."
  echo ""
  exit 1
fi
