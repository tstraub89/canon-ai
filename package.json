{
  "name": "canon-ai",
  "version": "1.3.2",
  "type": "module",
  "description": "A spec-first, multi-agent coding pipeline you drop into any repo. The law your agents work under.",
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "canon": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "templates/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node scripts/normalize-dist-paths.mjs",
    "test": "node --test --import ./tests/md-loader-register.mjs --import tsx tests/*.test.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint scripts/ tests/ src/"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.0.0",
    "eslint": "^10.3.0",
    "mustache": "^4.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  }
}
