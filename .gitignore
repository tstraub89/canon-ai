node_modules
build
# dist/ is committed — see CHANGELOG 1.0.2 / npm cli#8440.
# `npm install -g <git-url>` doesn't reliably install devDeps before
# running `prepare`, so we cannot rebuild dist/ at install time. CI
# enforces freshness via `npm run build && git diff --exit-code dist/`.
.env
.env.*
!.env.example
*.log
.DS_Store
.vscode/
.idea/
.claude/settings.local.json

# Pipeline scratch
*.tmp
.canon-write-test
tasks/*/runtime-check-output/

# canon:start
# This block is managed by canon. Edits are overwritten on `canon upgrade`.
tasks/**/.canon-pid
tasks/**/.canon-run.log
tasks/**/.heartbeat.json
tasks/**/.pr-number
.canon/worktrees/
# canon:end
