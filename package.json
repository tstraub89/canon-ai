{
  "name": "canon-ai",
  "version": "3.3.1",
  "type": "module",
  "description": "A spec-first, multi-agent AI coding pipeline you drop into any repo. The law your agents work under.",
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "canon": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "templates/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node scripts/normalize-dist-paths.mjs",
    "hooks": "node scripts/install-git-hooks.mjs",
    "test": "node --test --import ./tests/md-loader-register.mjs --import tsx tests/*.test.ts",
    "sync-templates": "tsx scripts/sync-canon-templates.mjs",
    "sync-templates:check": "tsx scripts/sync-canon-templates.mjs --check",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint scripts/ tests/ src/",
    "docs-refs-check": "node scripts/docs-refs-check.mjs"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.13.3",
    "eslint": "^10.10.0",
    "mustache": "^4.2.0",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run sync-templates -- --stage"
  },
  "license": "MIT",
  "author": "Tim Straub",
  "homepage": "https://github.com/tstraub89/canon-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tstraub89/canon-ai.git"
  },
  "bugs": {
    "url": "https://github.com/tstraub89/canon-ai/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "claude",
    "codex",
    "pipeline",
    "spec-driven",
    "code-review",
    "cli",
    "orchestration"
  ]
}
