{
  "name": "canon-ai",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "A spec-first, multi-agent coding pipeline you drop into any repo. The law your agents work under.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test --import tsx tests/*.test.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "task": "./scripts/task.sh",
    "run-task": "tsx scripts/run-task.ts",
    "lint": "eslint scripts/ tests/",
    "setup-hooks": "ln -sf ../../scripts/git-hooks/pre-merge-commit .git/hooks/pre-merge-commit && chmod +x .git/hooks/pre-merge-commit && echo 'Git hooks installed.'"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.0.0",
    "eslint": "^10.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "mustache": "^4.2.0"
  }
}
