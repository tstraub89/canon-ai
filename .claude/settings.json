{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Agent",
      "WebFetch",
      "WebSearch",
      "Monitor",

      "Bash(git *)",
      "Bash(gh *)",

      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(ls *)",
      "Bash(find *)",

      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(tr *)",
      "Bash(xargs *)",
      "Bash(tee *)",
      "Bash(jq *)",

      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm audit)",
      "Bash(npm audit *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",

      "Bash(npx canon *)",
      "Bash(npx tsc *)",
      "Bash(canon *)",

      "Bash(npx tsx *)",
      "Bash(node *)",

      "Bash(codex *)",

      "Skill(canon-init)",
      "Skill(canon-changelog)",
      "Skill(canon-changelog:*)",
      "Skill(canon-status)",
      "Skill(canon-status:*)",
      "Skill(canon-spec)",
      "Skill(canon-spec:*)",
      "Skill(canon-pipeline)",
      "Skill(canon-pipeline:*)",
      "Skill(canon-review)",
      "Skill(canon-review:*)"
    ],
    "additionalDirectories": [
      "../dev-worktrees"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && echo '## In-progress tasks' && canon task list 2>/dev/null || echo '(none)'"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "npm",
      "npm *",
      "npx",
      "npx *"
    ]
  }
}
